{
  "name": "shortform-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first short-form clipping pipeline with traceable artifacts.",
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "docs",
    ".agents"
  ],
  "bin": {
    "sf": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "curious:v1": "node production-profiles/bizarrement-curieux/v1/run.mjs",
    "dashboard:dev": "node dashboard/dev.mjs",
    "dashboard:build": "vite build --config dashboard/vite.config.ts && tsc -p dashboard/tsconfig.server.json",
    "dashboard:start": "node dashboard/dist/server/server/main.js",
    "dashboard:test": "vitest run --config dashboard/vitest.config.ts",
    "dashboard:type-check": "tsc -p dashboard/tsconfig.client.json --noEmit && tsc -p dashboard/tsconfig.server.json --noEmit",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "sf": "node dist/cli.js",
    "sf:dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
